rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function expenseMemberPath(householdId, userId) {
      return /databases/$(database)/documents/expenseHouseholds/$(householdId)/members/$(userId);
    }

    function isExpenseMember(householdId) {
      return signedIn() && exists(expenseMemberPath(householdId, request.auth.uid));
    }

    function isExpenseOwner(householdId) {
      return isExpenseMember(householdId)
        && get(expenseMemberPath(householdId, request.auth.uid)).data.role == "owner";
    }

    match /subscribers/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /expenseHouseholds/{householdId} {
      allow get: if signedIn() && householdId == "sai-naveen";
      allow list: if false;

      allow create: if signedIn()
        && householdId == "sai-naveen"
        && request.resource.data.keys().hasOnly([
          "name",
          "ownerUid",
          "naveenUid",
          "naveenInviteToken",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.name == "Sai & Naveen"
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.naveenUid == ""
        && request.resource.data.naveenInviteToken == ""
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if request.resource.data.keys().hasOnly([
          "name",
          "ownerUid",
          "naveenUid",
          "naveenInviteToken",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.name == resource.data.name
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          (
            isExpenseOwner(householdId)
            && request.resource.data.naveenUid == resource.data.naveenUid
            && request.resource.data.naveenInviteToken == resource.data.naveenInviteToken
          )
          ||
          (
            signedIn()
            && resource.data.naveenUid == ""
            && request.resource.data.naveenUid == request.auth.uid
            && resource.data.naveenInviteToken == ""
            && request.resource.data.naveenInviteToken is string
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "naveenUid",
              "naveenInviteToken",
              "updatedAt"
            ])
            && get(
              /databases/$(database)/documents/expenseInvites/$(request.resource.data.naveenInviteToken)
            ).data.active == true
            && get(
              /databases/$(database)/documents/expenseInvites/$(request.resource.data.naveenInviteToken)
            ).data.expiresAt > request.time
            && getAfter(
              /databases/$(database)/documents/expenseInvites/$(request.resource.data.naveenInviteToken)
            ).data.active == false
            && getAfter(
              /databases/$(database)/documents/expenseInvites/$(request.resource.data.naveenInviteToken)
            ).data.claimedBy == request.auth.uid
          )
        );

      allow delete: if false;

      match /members/{memberId} {
        allow get: if signedIn()
          && (request.auth.uid == memberId || isExpenseMember(householdId));
        allow list: if isExpenseMember(householdId);

        allow create: if signedIn()
          && householdId == "sai-naveen"
          && memberId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.joinedAt == request.time
          && (
            (
              request.resource.data.keys().hasOnly([
                "uid",
                "displayName",
                "role",
                "email",
                "photoURL",
                "joinedAt"
              ])
              && request.resource.data.displayName == "Sai"
              && request.resource.data.role == "owner"
              && getAfter(
                /databases/$(database)/documents/expenseHouseholds/$(householdId)
              ).data.ownerUid == request.auth.uid
            )
            ||
            (
              request.resource.data.keys().hasOnly([
                "uid",
                "displayName",
                "role",
                "inviteToken",
                "email",
                "photoURL",
                "joinedAt"
              ])
              && request.resource.data.displayName == "Naveen"
              && request.resource.data.role == "member"
              && request.resource.data.inviteToken is string
              && request.resource.data.inviteToken == getAfter(
                /databases/$(database)/documents/expenseHouseholds/$(householdId)
              ).data.naveenInviteToken
              && getAfter(
                /databases/$(database)/documents/expenseHouseholds/$(householdId)
              ).data.naveenUid == request.auth.uid
              && get(
                /databases/$(database)/documents/expenseInvites/$(request.resource.data.inviteToken)
              ).data.active == true
              && get(
                /databases/$(database)/documents/expenseInvites/$(request.resource.data.inviteToken)
              ).data.householdId == householdId
              && get(
                /databases/$(database)/documents/expenseInvites/$(request.resource.data.inviteToken)
              ).data.expiresAt > request.time
              && getAfter(
                /databases/$(database)/documents/expenseInvites/$(request.resource.data.inviteToken)
              ).data.active == false
              && getAfter(
                /databases/$(database)/documents/expenseInvites/$(request.resource.data.inviteToken)
              ).data.claimedBy == request.auth.uid
            )
          );

        allow update, delete: if false;
      }

      match /categories/{categoryId} {
        allow read: if isExpenseMember(householdId);
        allow create: if isExpenseMember(householdId)
          && request.resource.data.keys().hasOnly([
            "name",
            "isDefault",
            "createdByUid",
            "createdAt"
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.isDefault is bool
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /expenses/{expenseId} {
        allow read: if isExpenseMember(householdId);
        allow create: if isExpenseMember(householdId)
          && request.resource.data.keys().hasOnly([
            "amountPaise",
            "categoryId",
            "categoryName",
            "description",
            "expenseDate",
            "paidByUid",
            "paidByName",
            "createdByUid",
            "createdAt",
            "updatedAt"
          ])
          && request.resource.data.amountPaise is int
          && request.resource.data.amountPaise > 0
          && request.resource.data.amountPaise <= 1000000000
          && request.resource.data.categoryId is string
          && request.resource.data.categoryName is string
          && request.resource.data.categoryName.size() > 0
          && request.resource.data.categoryName.size() <= 40
          && request.resource.data.description is string
          && request.resource.data.description.size() > 0
          && request.resource.data.description.size() <= 80
          && request.resource.data.expenseDate is string
          && request.resource.data.expenseDate.matches(
            "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          )
          && request.resource.data.paidByUid is string
          && exists(expenseMemberPath(householdId, request.resource.data.paidByUid))
          && request.resource.data.paidByName in ["Sai", "Naveen"]
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if false;
        allow delete: if isExpenseMember(householdId);
      }
    }

    match /personalExpenseUsers/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;

      allow create: if signedIn()
        && request.auth.uid == userId
        && !exists(expenseMemberPath("sai-naveen", userId))
        && request.resource.data.keys().hasOnly([
          "uid",
          "displayName",
          "email",
          "photoURL",
          "inviteToken",
          "createdAt"
        ])
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.photoURL is string
        && request.resource.data.inviteToken is string
        && request.resource.data.createdAt == request.time
        && get(
          /databases/$(database)/documents/personalExpenseInvites/$(request.resource.data.inviteToken)
        ).data.inviteType == "personal"
        && get(
          /databases/$(database)/documents/personalExpenseInvites/$(request.resource.data.inviteToken)
        ).data.active == true
        && get(
          /databases/$(database)/documents/personalExpenseInvites/$(request.resource.data.inviteToken)
        ).data.expiresAt > request.time
        && getAfter(
          /databases/$(database)/documents/personalExpenseInvites/$(request.resource.data.inviteToken)
        ).data.active == false
        && getAfter(
          /databases/$(database)/documents/personalExpenseInvites/$(request.resource.data.inviteToken)
        ).data.claimedBy == userId;

      allow update, delete: if false;

      match /categories/{categoryId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            "name",
            "isDefault",
            "createdByUid",
            "createdAt"
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.isDefault is bool
          && request.resource.data.createdByUid == userId
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /expenses/{expenseId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            "amountPaise",
            "categoryId",
            "categoryName",
            "description",
            "expenseDate",
            "paidByUid",
            "paidByName",
            "createdByUid",
            "createdAt",
            "updatedAt"
          ])
          && request.resource.data.amountPaise is int
          && request.resource.data.amountPaise > 0
          && request.resource.data.amountPaise <= 1000000000
          && request.resource.data.categoryId is string
          && request.resource.data.categoryName is string
          && request.resource.data.categoryName.size() > 0
          && request.resource.data.categoryName.size() <= 40
          && request.resource.data.description is string
          && request.resource.data.description.size() > 0
          && request.resource.data.description.size() <= 80
          && request.resource.data.expenseDate is string
          && request.resource.data.expenseDate.matches(
            "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          )
          && request.resource.data.paidByUid == userId
          && request.resource.data.paidByName == get(
            /databases/$(database)/documents/personalExpenseUsers/$(userId)
          ).data.displayName
          && request.resource.data.createdByUid == userId
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if false;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /personalExpenseInvites/{inviteToken} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "inviteType",
          "active",
          "createdByUid",
          "createdAt",
          "expiresAt"
        ])
        && request.resource.data.inviteType == "personal"
        && isExpenseOwner("sai-naveen")
        && request.resource.data.active == true
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time;

      allow update: if signedIn()
        && resource.data.inviteType == "personal"
        && resource.data.active == true
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "active",
          "claimedBy",
          "claimedAt"
        ])
        && request.resource.data.active == false
        && request.resource.data.claimedBy == request.auth.uid
        && request.resource.data.claimedAt == request.time;

      allow delete: if false;
    }

    match /expenseInvites/{inviteToken} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "householdId",
          "displayName",
          "role",
          "active",
          "createdByUid",
          "createdAt",
          "expiresAt"
        ])
        && request.resource.data.householdId == "sai-naveen"
        && isExpenseOwner(request.resource.data.householdId)
        && request.resource.data.displayName == "Naveen"
        && request.resource.data.role == "member"
        && request.resource.data.active == true
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time;

      allow update: if signedIn()
        && resource.data.householdId == "sai-naveen"
        && resource.data.active == true
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "active",
          "claimedBy",
          "claimedAt"
        ])
        && request.resource.data.active == false
        && request.resource.data.claimedBy == request.auth.uid
        && request.resource.data.claimedAt == request.time;

      allow delete: if false;
    }
  }
}
